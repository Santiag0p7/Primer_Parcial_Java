# ==========================================
# REGLAS ADICIONALES PARA JAVA WEB / IDEs
# ==========================================

# Carpetas de compilación y temporales
/build/
/target/
/dist/
/out/
/work/
/tmp/

# Archivos de configuración de IDEs (VS Code, Eclipse, NetBeans, IntelliJ)
.settings/
.classpath
.project
.idea/
.vscode/
*.iml
*.nbconst
/nbproject/private/

# Sistema operativo
.DS_Store
Thumbs.db

# ==========================================
# EXCEPCIONES: DEPENDENCIAS NECESARIAS
# ==========================================
# El proyecto NO usa Maven/Gradle: los JAR de WEB-INF/lib son
# dependencias obligatorias para ejecutar en Tomcat y SI deben versionarse.
!WEB-INF/lib/
!WEB-INF/lib/*.jar

# Clases compiladas (generadas por el IDE / javac)
/WEB-INF/classes/
