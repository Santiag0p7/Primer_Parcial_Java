<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>JSGE In-Mobiliaria</display-name>
    <description>Sistema de Administracion Inmobiliaria - Primer Parcial Java UTS</description>

    <welcome-file-list>
        <welcome-file>index</welcome-file>
    </welcome-file-list>

    <!-- ==========================================
         CONFIGURACION INICIAL
         ========================================== -->

    <!-- Carga la configuracion de BD desde /conexion.jspf (raiz) -->
    <listener>
        <listener-class>com.inmobiliaria.util.AppConfigListener</listener-class>
    </listener>

    <!-- ==========================================
         SERVLETS - Controladores
         ========================================== -->

    <!-- Landing Page / Pagina Principal -->
    <servlet>
        <servlet-name>LandingServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.LandingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LandingServlet</servlet-name>
        <url-pattern>/index</url-pattern>
    </servlet-mapping>

    <!-- Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <!-- Registro -->
    <servlet>
        <servlet-name>RegistroServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.RegistroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistroServlet</servlet-name>
        <url-pattern>/RegistroServlet</url-pattern>
    </servlet-mapping>

    <!-- Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <!-- CRUD de Propiedades (Sprint 2) -->
    <servlet>
        <servlet-name>PropiedadServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.PropiedadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PropiedadServlet</servlet-name>
        <url-pattern>/PropiedadServlet</url-pattern>
    </servlet-mapping>

    <!-- Ficha de detalle publica de una propiedad -->
    <servlet-mapping>
        <servlet-name>PropiedadServlet</servlet-name>
        <url-pattern>/propiedad</url-pattern>
    </servlet-mapping>

    <!-- Gestion del Perfil de Usuario (relacion 1:1) - Sprint 2 -->
    <servlet>
        <servlet-name>PerfilServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.PerfilServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PerfilServlet</servlet-name>
        <url-pattern>/PerfilServlet</url-pattern>
    </servlet-mapping>

    <!-- Buscador / Catalogo publico de propiedades -->
    <servlet>
        <servlet-name>BuscarPropiedadesServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.BuscarPropiedadesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BuscarPropiedadesServlet</servlet-name>
        <url-pattern>/buscar</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BuscarPropiedadesServlet</servlet-name>
        <url-pattern>/catalogo</url-pattern>
    </servlet-mapping>

    <!-- Reportes del sistema (solo Administrador) - Sprint 2 -->
    <servlet>
        <servlet-name>ReporteServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.ReporteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReporteServlet</servlet-name>
        <url-pattern>/ReporteServlet</url-pattern>
    </servlet-mapping>

    <!-- Dashboard con metricas por rol (Sprint 3 - Item 3) -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/DashboardServlet</url-pattern>
    </servlet-mapping>

    <!-- Sistema de Solicitud de Citas y Agendamiento (Sprint 3 - Item 1) -->
    <servlet>
        <servlet-name>SolicitudServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.SolicitudServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SolicitudServlet</servlet-name>
        <url-pattern>/SolicitudServlet</url-pattern>
    </servlet-mapping>

    <!-- Administracion Global: Gestion de Usuarios (Sprint 3 - Item 2) -->
    <servlet>
        <servlet-name>AdminUsuarioServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.AdminUsuarioServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUsuarioServlet</servlet-name>
        <url-pattern>/AdminUsuarioServlet</url-pattern>
    </servlet-mapping>

    <!-- Administracion Global: Mantenimiento de Parametros (Sprint 3 - Item 2) -->
    <servlet>
        <servlet-name>AdminParametrosServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.AdminParametrosServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminParametrosServlet</servlet-name>
        <url-pattern>/AdminParametrosServlet</url-pattern>
    </servlet-mapping>

    <!-- Administracion Global: Gestion de Propiedades (Admin) -->
    <servlet>
        <servlet-name>AdminPropiedadServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.AdminPropiedadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPropiedadServlet</servlet-name>
        <url-pattern>/AdminPropiedadServlet</url-pattern>
    </servlet-mapping>

    <!-- Modulo de Favoritos del Cliente -->
    <servlet>
        <servlet-name>FavoritoServlet</servlet-name>
        <servlet-class>com.inmobiliaria.controller.FavoritoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FavoritoServlet</servlet-name>
        <url-pattern>/FavoritoServlet</url-pattern>
    </servlet-mapping>

    <!-- ==========================================
         FILTROS - Seguridad
         ========================================== -->

    <!-- Filtro de Autenticacion y Control de Acceso por Rol -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.inmobiliaria.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/dashboard/*</url-pattern>
    </filter-mapping>

    <!-- ==========================================
         CONFIGURACION DE SESION
         ========================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/index</location>
    </error-page>

</web-app>
